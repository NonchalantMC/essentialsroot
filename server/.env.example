NODE_ENV=development
PORT=5000
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_PANEL_URL=http://localhost:5173

# PesaPal
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=PESAPAL_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=PESAPAL_CONSUMER_SECRET
PESAPAL_CALLBACK_URL=PESAPAL_CALLBACK_URL
PESAPAL_IPN_URL=http://yourdomain.com
PESAPAL_IPN_ID=

# Cloudinary (for product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — Brevo (https://app.brevo.com/settings/keys/api)
# FROM_EMAIL must be a verified sender in your Brevo account
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=orders@essentials256.com
ADMIN_EMAIL=your_admin_email@example.com

# Africa's Talking (guest OTP SMS)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox

# Admin notifications
ADMIN_PHONE=+256700000000